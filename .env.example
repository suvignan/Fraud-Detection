# Environment variable NAMES only, never real values. Copy to .env and fill in locally.
# DVC credentials do NOT go here: they live in .dvc/config.local (set with `dvc remote modify --local`).
# MLflow on DagsHub (used later):
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
# Neon Postgres (Day 5):
DATABASE_URL=
# Where /predict gets card history: file (Parquet) or neon
HISTORY_BACKEND=file
# Secret key for HMAC-hashing card numbers (Day 5 part B). Long random string, never committed.
CARD_KEY_SECRET=
