# Data is tracked by DVC, never by git
# (the small .dvc ticket files inside data/ ARE committed)
/data/raw/
/data/interim/
/data/processed/
# models: git tracks ONLY the 3 small files the Docker image needs (Render builds from GitHub)
models/*
!models/model.json
!models/feature_spec.json
!models/guardrails.json
mlruns/
mlflow.db

# Environments and secrets
.venv/
ml environment/
.env

